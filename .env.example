# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real credentials.

# MongoDB Atlas — get the connection string from the Atlas UI (Database → Connect → Drivers).
# Include the database name in the path: mongodb+srv://.../retrospectiq?retryWrites=true&w=majority
MONGODB_URI=

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# OpenAI — used server-side only, for building profile extraction.
OPENAI_API_KEY=

# Better Auth — generate the secret with: openssl rand -base64 32
# BETTER_AUTH_URL is the site origin (http://localhost:3000 locally).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional; the button appears only when both are set).
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft / Outlook sign-in (optional; tenant "common").
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional: account that `npm run seed` assigns the demo portfolio to.
SEED_OWNER_EMAIL=
